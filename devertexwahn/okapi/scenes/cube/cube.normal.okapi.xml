<scene version='3.0.0'>
    <sensor type="perspective">
        <float name="fov" value="30"/>

        <film>
            <integer name="width" value="800" />
            <integer name="height" value="600" />
            <string name="filename" value="cube.normal.exr" />
        </film>

        <transform>
            <lookat origin="0, 0, -10" target="0, 0, 0" up="0, 1, 0" />
        </transform>
    </sensor>

    <integrator type="normal" />

    <shape type="obj">
        <string name="filename" value="cube.obj" />

        <bsdf type="diffuse" />

        <transform name="to_world">
            <scale x="1" y="1" z="1" />
        </transform>
    </shape>
</scene>
