<scene version="3.0.0">
	<integrator type="next"/>

	<sensor type="perspective">
		<float name="fov" value="30"/>

        <transform name="to_world">
            <lookat target="-40.4632853386, 43.4968674997, -28.9039342736"
                    origin="-52.0518243138, 51.4398222998, -43.1382320598"
                    up="0.250740348753, 0.917754690867, 0.307986371289" />
        </transform>

		<film type="hdrfilm">
			<rfilter type="gaussian"/>
			<integer name="width" value="768" />
			<integer name="height" value="768" />
            <string name="filename" value="ajax.constant_emitter.spp512.exr" />
		</film>

		<sampler type="independent">
			<integer name="sample_count" value="512"/>
		</sampler>
	</sensor>

    <intersector type="embree" />

	<emitter type="constant">
    	<rgb name="radiance" value="1.0"/>
	</emitter>

	<!-- Load the Ajax bust (a freely available scan from the Jotero forum) -->
	<shape type="obj">
		<string name="filename" value="ajax.obj"/>

        <bsdf type="diffuse">
            <rgb name="reflectance" value="0.7" />
        </bsdf>
	</shape>

	<!-- Ground plane -->
	<shape type="obj">
		<string name="filename" value="plane.obj" />

		<bsdf type="diffuse">
			<rgb name="reflectance" value="0.7" />
		</bsdf>

		<transform name="to_world">
			<scale x="100" y="1" z="100" />
		</transform>
	</shape>
</scene>
